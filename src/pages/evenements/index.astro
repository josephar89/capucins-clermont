---
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const sortedEvents = allEvents.sort(
  (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Agenda & Événements | Frères Capucins Clermont-Ferrand"
  description="Découvrez l'agenda des événements, retraites, célébrations de fêtes et rencontres spirituelles chez les Frères Capucins à Clermont-Ferrand."
>
  <section class="bg-gradient-to-r from-[#3A2216] to-[#5C3826] text-white py-14 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-200 border border-amber-400/30 uppercase tracking-wider mb-4">
        Calendrier & Activités
      </span>
      <h1 class="font-display font-bold text-3xl sm:text-5xl text-amber-100">
        Agenda des Événements
      </h1>
      <p class="mt-4 text-base sm:text-lg text-stone-200 max-w-2xl mx-auto font-serif">
        Retrouvez les prochaines fêtes, veillées de prière, récollections et temps forts fraternels.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {sortedEvents.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedEvents.map((event) => (
          <EventCard
            id={event.id}
            title={event.data.title}
            date={event.data.date}
            time={event.data.time}
            location={event.data.location}
            summary={event.data.summary}
            image={event.data.image}
            featured={event.data.featured}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white rounded-3xl border border-stone-200 p-8">
        <p class="text-lg text-stone-600 font-serif">Aucun événement à venir pour le moment.</p>
        <p class="text-sm text-stone-400 mt-2">Revenez bientôt ou consultez les horaires habituels des offices.</p>
        <a href={`${base}/horaires`} class="inline-block mt-4 text-[#7B462C] font-semibold underline">
          Voir les horaires réguliers &rarr;
        </a>
      </div>
    )}
  </div>
</Layout>
