---
import Layout from '../layouts/Layout.astro';
import HorairesBanner from '../components/HorairesBanner.astro';
import EventCard from '../components/EventCard.astro';
import PostCard from '../components/PostCard.astro';
import MapSection from '../components/MapSection.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
// Sort events by date ascending
const upcomingEvents = allEvents
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 3);

const allPosts = await getCollection('posts');
// Sort posts by date descending
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout>
  <!-- Hero Section -->
  <section class="relative bg-stone-950 text-white min-h-[85vh] sm:min-h-[88vh] flex flex-col justify-end overflow-hidden pt-28 sm:pt-36 pb-12 sm:pb-16">
    <!-- Atmospheric background altar image with directional lighting -->
    <div class="absolute inset-0 pointer-events-none">
      <img
        src={`${base}/images/chapelle-autel-choeur.jpg`}
        alt="Chœur et Maître-Autel de la Chapelle des Capucins"
        class="w-full h-full object-cover object-[center_20%] scale-100"
      />
      <!-- Top subtle vignette for header contrast -->
      <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-black/70 via-black/30 to-transparent"></div>
      
      <!-- Bottom rich gradient: keeps the upper sanctuary luminous while providing crisp contrast for text over the steps -->
      <div class="absolute inset-x-0 bottom-0 h-4/5 sm:h-3/4 bg-gradient-to-t from-stone-950 via-[#1F120B]/90 via-55% to-transparent"></div>
    </div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-5">
      <!-- Tag / Subtitle -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-black/40 text-amber-200 border border-amber-400/30 text-xs sm:text-sm font-semibold tracking-wide uppercase backdrop-blur-md shadow-md">
        <span>🕊️</span>
        Chapelle des Frères Mineurs Capucins — Clermont-Ferrand
      </div>

      <!-- Main Headline -->
      <h1 class="font-display font-bold text-2xl sm:text-4xl lg:text-5xl text-amber-50 tracking-tight leading-tight sm:leading-tight drop-shadow-lg">
        Une Maison de Prière, de Silence et de Fraternité
      </h1>

      <p class="text-sm sm:text-base lg:text-lg text-stone-200 max-w-2xl mx-auto leading-relaxed font-serif drop-shadow-md">
        Au cœur de Clermont-Ferrand, face au Jardin Lecoq, les frères vous accueillent chaque jour pour la prière, la messe quotidienne, l'adoration et l'écoute fraternelle.
      </p>

      <!-- Primary Action Buttons -->
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a
          href={`${base}/horaires`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-amber-500 text-stone-950 font-bold text-sm sm:text-base hover:bg-amber-400 shadow-lg shadow-amber-900/40 transition-all active:scale-95"
        >
          <svg class="w-5 h-5 text-stone-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Horaires des Messes & Adoration
        </a>
        <a
          href={`${base}/evenements`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-white/15 hover:bg-white/25 text-white font-semibold text-sm sm:text-base border border-white/25 backdrop-blur-md transition-all"
        >
          Agenda & Événements &rarr;
        </a>
      </div>

      <!-- Quick Highlights bar -->
      <div class="pt-6 border-t border-white/15 max-w-2xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-4 text-center text-xs text-stone-300">
        <div>
          <span class="block text-xl font-bold text-amber-300 font-display">1608</span>
          <span class="text-stone-400">Présence à Clermont</span>
        </div>
        <div>
          <span class="block text-xl font-bold text-amber-300 font-display">19h00</span>
          <span class="text-stone-400">Messe quotidienne</span>
        </div>
        <div>
          <span class="block text-xl font-bold text-amber-300 font-display">8h00 – 20h30</span>
          <span class="text-stone-400">Chapelle ouverte</span>
        </div>
        <div>
          <span class="block text-xl font-bold text-amber-300 font-display">Vendredi</span>
          <span class="text-stone-400">Adoration continue</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16 sm:space-y-24">
    
    <!-- Horaires Banner Component -->
    <HorairesBanner />

    <!-- Upcoming Events Section -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-[#7B462C] uppercase tracking-wider mb-2">
            À vos agendas
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-[#3A2216]">
            Prochains Événements & Rencontres
          </h2>
          <p class="text-stone-600 text-sm mt-1">
            Les célébrations solennelles, groupes de prière et activités de la fraternité.
          </p>
        </div>
        <a href={`${base}/evenements`} class="inline-flex items-center gap-1 text-sm font-semibold text-[#7B462C] hover:text-[#5C3826] transition group whitespace-nowrap">
          Voir tout l'agenda
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {upcomingEvents.map((event) => (
          <EventCard
            id={event.id}
            title={event.data.title}
            date={event.data.date}
            time={event.data.time}
            location={event.data.location}
            summary={event.data.summary}
            image={event.data.image}
            featured={event.data.featured}
          />
        ))}
      </div>
    </section>

    <!-- Spiritual & Community Overview Section -->
    <section class="bg-gradient-to-br from-[#F5EFE6] to-[#E8DED1] rounded-3xl p-8 sm:p-12 lg:p-16 border border-stone-300/60 shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#7B462C] text-amber-100 uppercase tracking-wider">
            La Fraternité
          </span>
          <h2 class="font-display text-2xl sm:text-4xl font-bold text-[#3A2216] leading-tight">
            Les Frères Capucins au Service de Dieu et des Hommes
          </h2>
          <div class="text-stone-700 text-sm sm:text-base leading-relaxed space-y-4 font-serif">
            <p>
              Fils de saint François d'Assise, les Frères Mineurs Capucins mènent une vie fraternelle alliant prière contemplative assidue, simplicité évangélique et présence bienveillante au cœur de Clermont-Ferrand.
            </p>
            <p>
              Inscrite au sein du <strong>« Projet Saint Laurent de Brindes »</strong>, notre communauté est une fraternité internationale (France, Italie, Madagascar, Inde). Les frères s'investissent au service de tous : aumônerie pénitentiaire à Riom, réinsertion avec <em>Mains Ouvertes</em>, accueil au <em>Café Chrétien Cappuccino</em> (rue du Port) et animation du <em>Groupe Padre Pio</em>.
            </p>
          </div>
          <div class="pt-2 flex flex-wrap gap-4">
            <a href={`${base}/fraternite`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#7B462C] text-white font-semibold text-sm hover:bg-[#5C3826] transition shadow-xs">
              Découvrir la Fraternité & son Histoire &rarr;
            </a>
            <a href={`${base}/padre-pio`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-stone-800 font-semibold text-sm hover:bg-stone-50 border border-stone-300 transition">
              Groupe Padre Pio
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="rounded-2xl overflow-hidden shadow-md h-48 bg-stone-200">
              <img src={`${base}/images/portrait-frere-capucin.jpg`} alt="Frère capucin" class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="rounded-2xl overflow-hidden shadow-md h-52 bg-stone-200">
              <img src={`${base}/images/freres-priere-adoration.jpg`} alt="Prière et adoration à la chapelle" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
          <div class="space-y-4 pt-6">
            <div class="rounded-2xl overflow-hidden shadow-md h-52 bg-stone-200">
              <img src={`${base}/images/fraternite-repas-communaute.jpg`} alt="Vie fraternelle et repas partagé" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="rounded-2xl overflow-hidden shadow-md h-48 bg-stone-200">
              <img src={`${base}/images/frere-dialogue-jeunes.jpg`} alt="Échange avec les jeunes au jardin" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Recent News / Chronicle Section -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-stone-200 text-stone-700 uppercase tracking-wider mb-2">
            Journal & Échos
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-[#3A2216]">
            Dernières Actualités de la Communauté
          </h2>
          <p class="text-stone-600 text-sm mt-1">
            Partages spirituels, nouvelles de la paroisse et chroniques des frères.
          </p>
        </div>
        <a href={`${base}/actualites`} class="inline-flex items-center gap-1 text-sm font-semibold text-[#7B462C] hover:text-[#5C3826] transition group whitespace-nowrap">
          Toutes les actualités
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {recentPosts.map((post) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            date={post.data.date}
            author={post.data.author}
            summary={post.data.summary}
            image={post.data.image}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>

    <!-- Interactive Map & Access Section -->
    <MapSection />

  </div>
</Layout>
