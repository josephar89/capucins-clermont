---
import Layout from '../layouts/Layout.astro';
import MapSection from '../components/MapSection.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Contact & Plan d'Accès | Frères Capucins Clermont-Ferrand"
  description="Contactez la fraternité des Frères Capucins à Clermont-Ferrand (téléphone, email, adresse) et informations pour demander une intention de messe."
>
  <section class="bg-gradient-to-r from-[#3A2216] to-[#5C3826] text-white py-14 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-200 border border-amber-400/30 uppercase tracking-wider mb-4">
        Nous Joindre & Nous Trouver
      </span>
      <h1 class="font-display font-bold text-3xl sm:text-5xl text-amber-100">
        Contact & Informations Pratiques
      </h1>
      <p class="mt-4 text-base sm:text-lg text-stone-200 max-w-2xl mx-auto font-serif">
        Les frères sont à votre écoute pour toute demande de renseignement, intention de messe ou échange fraternel.
      </p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12">
    
    <!-- 3 Quick Contact Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Address -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white border border-stone-200 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-[#7B462C] flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h2 class="font-display font-bold text-xl text-[#3A2216]">Adresse</h2>
          <p class="text-sm text-stone-600 mt-2 leading-relaxed">
            <strong>Frères Mineurs Capucins</strong><br />
            9 Boulevard Lafayette<br />
            63000 Clermont-Ferrand
          </p>
          <p class="text-xs text-amber-800 font-semibold mt-1">En face de l'entrée du Jardin Lecoq</p>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100">
          <a href="https://maps.google.com/?q=9+Boulevard+Lafayette+63000+Clermont-Ferrand" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[#7B462C] hover:underline">
            Itinéraire Google Maps &rarr;
          </a>
        </div>
      </div>

      <!-- Phone -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white border border-stone-200 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-[#7B462C] flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <h2 class="font-display font-bold text-xl text-[#3A2216]">Téléphone</h2>
          <p class="text-sm text-stone-600 mt-2 leading-relaxed">
            Pour joindre l'accueil de la fraternité ou l'un des frères prêtres disponibles.
          </p>
          <div class="mt-3 space-y-1">
            <p class="text-2xl font-bold font-display text-[#7B462C]">
              04 73 42 49 38
            </p>
            <p class="text-xs text-stone-500 font-mono">
              Ligne directe : 04 73 92 66 38
            </p>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between">
          <a href="tel:0473424938" class="text-xs font-semibold text-[#7B462C] hover:underline">
            Appeler (04 73 42 49 38) &rarr;
          </a>
        </div>
      </div>

      <!-- Email -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white border border-stone-200 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-[#7B462C] flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h2 class="font-display font-bold text-xl text-[#3A2216]">Courrier Électronique</h2>
          <p class="text-sm text-stone-600 mt-2 leading-relaxed">
            Pour vos messages écrits, demandes de certificats ou questions pratiques :
          </p>
          <p class="text-sm font-bold text-[#7B462C] mt-3 break-all font-mono">
            capucins.clermont@gmail.com
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-stone-100">
          <a href="mailto:capucins.clermont@gmail.com" class="text-xs font-semibold text-[#7B462C] hover:underline">
            Envoyer un email &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Section: Demander une Intention de Messe -->
    <div class="bg-gradient-to-br from-[#FAF7F2] to-[#F5EFE6] rounded-3xl p-8 sm:p-10 border border-stone-200 shadow-xs space-y-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🕯️</span>
        <h2 class="font-display font-bold text-2xl text-[#3A2216]">Faire célébrer une Messe</h2>
      </div>
      <p class="text-sm sm:text-base text-stone-700 leading-relaxed font-serif">
        Vous pouvez faire célébrer une messe pour vos proches défunts, pour une personne malade ou éprouvée, ou encore en action de grâce pour un anniversaire ou une prière exaucée.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm text-stone-600 pt-2 font-sans">
        <div class="p-4 rounded-xl bg-white border border-stone-200">
          <p class="font-bold text-stone-900 mb-1">Montant indicatif diocésain :</p>
          <p>L'offrande de messe recommandée en France est de <strong>18 €</strong> (liberté donnée selon les possibilités de chacun).</p>
        </div>
        <div class="p-4 rounded-xl bg-white border border-stone-200">
          <p class="font-bold text-stone-900 mb-1">Modalités pratiques :</p>
          <p>Adressez votre demande par courrier avec chèque à l'ordre de <em>« Couvent des Capucins »</em> ou directement à la sacristie après une messe.</p>
        </div>
      </div>
    </div>

    <!-- Map Component -->
    <MapSection />

  </div>
</Layout>
