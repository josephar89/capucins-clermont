---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Extract distinct years sorted descending
const years = Array.from(
  new Set(sortedPosts.map((p) => new Date(p.data.date).getFullYear()))
).sort((a, b) => b - a);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Actualités & Archives Chronologiques | Frères Capucins Clermont-Ferrand"
  description="Chroniques, partages spirituels et archives des Frères Capucins de Clermont-Ferrand classés chronologiquement par année."
>
  <section class="bg-gradient-to-r from-[#3A2216] to-[#5C3826] text-white py-14 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-200 border border-amber-400/30 uppercase tracking-wider mb-4">
        Journal & Mémoire
      </span>
      <h1 class="font-display font-bold text-3xl sm:text-5xl text-amber-100">
        Actualités & Archives de la Fraternité
      </h1>
      <p class="mt-4 text-base sm:text-lg text-stone-200 max-w-2xl mx-auto font-serif">
        Retrouvez les nouvelles de notre communauté, nos partages et l'historique complet des publications classé par année.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    
    <!-- Year Filter Bar -->
    <div class="flex flex-wrap items-center justify-center gap-2 border-b border-stone-200 pb-6">
      <span class="text-xs uppercase tracking-wider text-stone-500 font-bold mr-2">Filtrer par année :</span>
      <button
        type="button"
        class="year-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-[#7B462C] text-white shadow-xs cursor-pointer"
        data-year="all"
      >
        Toutes les années ({sortedPosts.length})
      </button>
      {years.map((year) => {
        const count = sortedPosts.filter((p) => new Date(p.data.date).getFullYear() === year).length;
        return (
          <button
            type="button"
            class="year-filter-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white text-stone-700 border border-stone-200 hover:border-amber-700 hover:text-[#7B462C] transition-all cursor-pointer"
            data-year={year}
          >
            {year} <span class="text-[10px] text-stone-400 font-normal">({count})</span>
          </button>
        );
      })}
    </div>

    <!-- Posts Grid -->
    <div id="posts-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post) => {
        const postYear = new Date(post.data.date).getFullYear();
        return (
          <div class="post-item transition-all duration-300" data-year={postYear}>
            <PostCard
              id={post.id}
              title={post.data.title}
              date={post.data.date}
              author={post.data.author}
              summary={post.data.summary}
              image={post.data.image}
              tags={post.data.tags}
            />
          </div>
        );
      })}
    </div>

    <!-- Empty state if filter has no items -->
    <div id="no-results" class="hidden text-center py-16 bg-white rounded-3xl border border-stone-200 p-8">
      <p class="text-lg text-stone-600 font-serif">Aucun article trouvé pour cette année.</p>
    </div>

  </div>

  <!-- Interactive Year Filter Script -->
  <script>
    const buttons = document.querySelectorAll('.year-filter-btn');
    const posts = document.querySelectorAll('.post-item');
    const noResults = document.getElementById('no-results');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Toggle active button style
        buttons.forEach((b) => {
          b.classList.remove('bg-[#7B462C]', 'text-white', 'shadow-xs');
          b.classList.add('bg-white', 'text-stone-700', 'border', 'border-stone-200');
        });
        btn.classList.remove('bg-white', 'text-stone-700', 'border', 'border-stone-200');
        btn.classList.add('bg-[#7B462C]', 'text-white', 'shadow-xs');

        const selectedYear = btn.getAttribute('data-year');
        let visibleCount = 0;

        posts.forEach((post) => {
          const postYear = post.getAttribute('data-year');
          if (selectedYear === 'all' || selectedYear === postYear) {
            (post as HTMLElement).style.display = 'block';
            visibleCount++;
          } else {
            (post as HTMLElement).style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  </script>
</Layout>
