---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Actualités & Vie de la Communauté | Frères Capucins Clermont-Ferrand"
  description="Chroniques, partages spirituels et actualités des Frères Capucins de Clermont-Ferrand."
>
  <section class="bg-gradient-to-r from-[#3A2216] to-[#5C3826] text-white py-14 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-200 border border-amber-400/30 uppercase tracking-wider mb-4">
        Journal & Chroniques
      </span>
      <h1 class="font-display font-bold text-3xl sm:text-5xl text-amber-100">
        Actualités & Vie des Frères
      </h1>
      <p class="mt-4 text-base sm:text-lg text-stone-200 max-w-2xl mx-auto font-serif">
        Retrouvez les nouvelles de notre communauté, les partages spirituels et les temps forts vécus à Clermont-Ferrand.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post) => (
        <PostCard
          id={post.id}
          title={post.data.title}
          date={post.data.date}
          author={post.data.author}
          summary={post.data.summary}
          image={post.data.image}
          tags={post.data.tags}
        />
      ))}
    </div>
  </div>
</Layout>
