---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Frères Capucins de Clermont-Ferrand | Chapelle & Fraternité",
  description = "Site officiel de la fraternité des Frères Mineurs Capucins à Clermont-Ferrand (63000). Horaires des messes, confessions, adoration eucharistique, groupe Padre Pio et actualités.",
  image = "/images/chapelle-autel-choeur.jpg"
} = Astro.props;

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="fr" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Google Fonts for warm, dignified typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    
    <style>
      .font-display { font-family: 'Cinzel', Georgia, serif; }
      .font-serif { font-family: 'Lora', Georgia, serif; }
      .font-sans { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    </style>
    <!-- Netlify Identity Widget for invite redirection -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body class="min-h-full flex flex-col font-sans text-stone-800 bg-[#FAF7F2] antialiased selection:bg-amber-200 selection:text-amber-900">
    <!-- Top notification banner for essential hours & quick call -->
    <div class="bg-[#3A2216] text-[#E8DED1] text-xs sm:text-sm py-2 px-4 border-b border-amber-900/30">
      <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 font-medium text-amber-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Chapelle ouverte aujourd'hui : 8h00 - 20h30
          </span>
          <span class="hidden md:inline text-stone-400">|</span>
          <span class="hidden md:inline text-stone-300">9 Boulevard Lafayette (face Jardin Lecoq)</span>
        </div>
        <div class="flex items-center gap-4 ml-auto">
          <a href="tel:0473926638" class="inline-flex items-center gap-1.5 text-amber-300 hover:text-white transition-colors font-medium">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            04 73 92 66 38
          </a>
          <a href={`${base}/admin`} class="hidden sm:inline-block text-[11px] px-2 py-0.5 rounded bg-stone-800/80 hover:bg-stone-700 text-stone-300 transition border border-stone-700">
            Espace Gestion
          </a>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-40 bg-[#FAF7F2]/95 backdrop-blur-md border-b border-stone-200/80 shadow-xs">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Site Logo / Branding -->
        <a href={`${base}/`} class="flex items-center gap-3.5 group">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#7B462C] to-[#452718] flex items-center justify-center text-amber-100 shadow-md ring-2 ring-amber-700/20 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <!-- Franciscan Tau Cross icon -->
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M12 6v14M8 6c0-1.5 1.5-2 4-2s4 .5 4 2" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-display font-bold text-lg sm:text-xl text-[#3A2216] tracking-wide leading-tight">
              Frères Capucins
            </span>
            <span class="text-xs uppercase tracking-wider text-[#8A5237] font-semibold">
              Clermont-Ferrand
            </span>
          </div>
        </a>

        <!-- Desktop Menu Links -->
        <div class="hidden lg:flex items-center gap-1 xl:gap-2">
          <a href={`${base}/`} class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${currentPath === '/' ? 'text-[#7B462C] bg-amber-100/60 font-semibold' : 'text-stone-700 hover:text-[#7B462C] hover:bg-stone-100/60'}`}>
            Accueil
          </a>
          <a href={`${base}/horaires`} class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${currentPath.startsWith('/horaires') ? 'text-[#7B462C] bg-amber-100/60 font-semibold' : 'text-stone-700 hover:text-[#7B462C] hover:bg-stone-100/60'}`}>
            Horaires & Messes
          </a>
          <a href={`${base}/evenements`} class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${currentPath.startsWith('/evenements') ? 'text-[#7B462C] bg-amber-100/60 font-semibold' : 'text-stone-700 hover:text-[#7B462C] hover:bg-stone-100/60'}`}>
            Événements
          </a>
          <a href={`${base}/actualites`} class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${currentPath.startsWith('/actualites') ? 'text-[#7B462C] bg-amber-100/60 font-semibold' : 'text-stone-700 hover:text-[#7B462C] hover:bg-stone-100/60'}`}>
            Actualités
          </a>
          <a href={`${base}/fraternite`} class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${currentPath.startsWith('/fraternite') ? 'text-[#7B462C] bg-amber-100/60 font-semibold' : 'text-stone-700 hover:text-[#7B462C] hover:bg-stone-100/60'}`}>
            La Fraternité
          </a>
          <a href={`${base}/padre-pio`} class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${currentPath.startsWith('/padre-pio') ? 'text-[#7B462C] bg-amber-100/60 font-semibold' : 'text-stone-700 hover:text-[#7B462C] hover:bg-stone-100/60'}`}>
            Padre Pio
          </a>
          <a href={`${base}/contact`} class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${currentPath.startsWith('/contact') ? 'text-[#7B462C] bg-amber-100/60 font-semibold' : 'text-stone-700 hover:text-[#7B462C] hover:bg-stone-100/60'}`}>
            Contact & Plan
          </a>
        </div>

        <!-- Quick CTA Button -->
        <div class="hidden sm:flex items-center gap-3">
          <a href={`${base}/horaires`} class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-[#7B462C] text-white hover:bg-[#5E3420] shadow-sm transition-all hover:shadow active:scale-95">
            <svg class="w-4 h-4 text-amber-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Voir les Horaires
          </a>
        </div>

        <!-- Mobile Menu Hamburger Button -->
        <button id="mobile-menu-btn" type="button" aria-label="Ouvrir le menu" class="lg:hidden p-2 rounded-lg text-stone-700 hover:text-[#7B462C] hover:bg-stone-200/50 transition">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </nav>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-stone-200 bg-[#FAF7F2] px-4 pt-3 pb-6 space-y-2 shadow-lg">
        <a href={`${base}/`} class="block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-amber-100/50">Accueil</a>
        <a href={`${base}/horaires`} class="block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-amber-100/50">Horaires & Messes</a>
        <a href={`${base}/evenements`} class="block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-amber-100/50">Événements & Agenda</a>
        <a href={`${base}/actualites`} class="block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-amber-100/50">Actualités & Vie de la communauté</a>
        <a href={`${base}/fraternite`} class="block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-amber-100/50">La Fraternité & Histoire</a>
        <a href={`${base}/padre-pio`} class="block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-amber-100/50">Groupe de Prière Padre Pio</a>
        <a href={`${base}/contact`} class="block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-amber-100/50">Contact & Accès</a>
        <div class="pt-3 border-t border-stone-200 flex flex-col gap-2">
          <a href="tel:0473926638" class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-amber-100 text-[#7B462C] font-semibold text-center">
            📞 Appeler : 04 73 92 66 38
          </a>
          <a href={`${base}/admin`} class="text-xs text-center text-stone-500 py-1">
            Connexion Espace Gestionnaire (Admin)
          </a>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#2D1B11] text-[#E8DED1] border-t-4 border-[#7B462C] pt-14 pb-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
          
          <!-- Column 1: Identity -->
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-[#7B462C] flex items-center justify-center text-amber-200">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M12 6v14M8 6c0-1.5 1.5-2 4-2s4 .5 4 2" />
                </svg>
              </div>
              <span class="font-display font-bold text-lg text-amber-100">Frères Capucins</span>
            </div>
            <p class="text-stone-300 text-sm leading-relaxed">
              Ordre des Frères Mineurs Capucins, présents au cœur de Clermont-Ferrand depuis 1608. Lieu de prière, de silence, d'écoute et de fraternité évangélique.
            </p>
            <p class="text-amber-300 text-xs italic">
              « Paix et Bien à tous ceux qui franchissent cette porte. »
            </p>
          </div>

          <!-- Column 2: Mass Hours Summary -->
          <div class="space-y-4">
            <h3 class="font-display font-semibold text-base text-amber-100 uppercase tracking-wider border-b border-amber-900/50 pb-2">
              Horaires Principaux
            </h3>
            <ul class="space-y-2 text-sm text-stone-300">
              <li class="flex justify-between items-baseline">
                <span class="font-medium text-stone-200">Messe quotidienne :</span>
                <span class="text-amber-300 font-semibold">19h00</span>
              </li>
              <li class="flex justify-between items-baseline">
                <span class="font-medium text-stone-200">Messe dominicale :</span>
                <span class="text-amber-300 font-semibold">10h00 & 19h00</span>
              </li>
              <li class="flex justify-between items-baseline">
                <span class="font-medium text-stone-200">Adoration (Vendredi) :</span>
                <span class="text-amber-300 font-semibold">8h30 - 20h30</span>
              </li>
              <li class="flex justify-between items-baseline">
                <span class="font-medium text-stone-200">Confessions :</span>
                <span class="text-stone-400">Mardi au Samedi</span>
              </li>
            </ul>
            <a href={`${base}/horaires`} class="inline-block text-xs text-amber-300 hover:text-white underline underline-offset-4">
              Tous les horaires détaillés &rarr;
            </a>
          </div>

          <!-- Column 3: Navigation Links -->
          <div class="space-y-4">
            <h3 class="font-display font-semibold text-base text-amber-100 uppercase tracking-wider border-b border-amber-900/50 pb-2">
              Navigation
            </h3>
            <ul class="space-y-2 text-sm text-stone-300">
              <li><a href={`${base}/`} class="hover:text-amber-200 transition">Accueil</a></li>
              <li><a href={`${base}/horaires`} class="hover:text-amber-200 transition">Horaires & Célébrations</a></li>
              <li><a href={`${base}/evenements`} class="hover:text-amber-200 transition">Agenda & Événements</a></li>
              <li><a href={`${base}/actualites`} class="hover:text-amber-200 transition">Nouvelles de la communauté</a></li>
              <li><a href={`${base}/fraternite`} class="hover:text-amber-200 transition">Histoire & Fraternité</a></li>
              <li><a href={`${base}/padre-pio`} class="hover:text-amber-200 transition">Groupe Padre Pio</a></li>
              <li><a href={`${base}/contact`} class="hover:text-amber-200 transition">Contact & Itinéraire</a></li>
            </ul>
          </div>

          <!-- Column 4: Location & Contact -->
          <div class="space-y-4">
            <h3 class="font-display font-semibold text-base text-amber-100 uppercase tracking-wider border-b border-amber-900/50 pb-2">
              Nous Trouver
            </h3>
            <address class="not-italic text-sm text-stone-300 space-y-2.5">
              <p class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span>9 Boulevard Lafayette<br />63000 Clermont-Ferrand<br /><span class="text-xs text-amber-300">(En face du Jardin Lecoq)</span></span>
              </p>
              <p class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <a href="tel:0473926638" class="hover:text-amber-200">04 73 92 66 38</a>
              </p>
              <p class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <a href="mailto:capucins.clermont@gmail.com" class="hover:text-amber-200 break-all">capucins.clermont@gmail.com</a>
              </p>
            </address>
          </div>

        </div>

        <!-- Subfooter -->
        <div class="mt-12 pt-6 border-t border-amber-900/40 flex flex-col sm:flex-row justify-between items-center text-xs text-stone-400 gap-4">
          <p>© {new Date().getFullYear()} Fraternité des Frères Mineurs Capucins — Clermont-Ferrand. Tous droits réservés.</p>
          <div class="flex items-center gap-4">
            <a href={`${base}/admin`} class="hover:text-amber-200 transition">Espace Gestionnaire</a>
            <span>•</span>
            <a href={`${base}/contact`} class="hover:text-amber-200 transition">Mentions légales</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Interactive script for mobile menu toggle -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
    <!-- Netlify Identity login redirect handler -->
    <script>
      // @ts-ignore
      if (window.netlifyIdentity) {
        // @ts-ignore
        window.netlifyIdentity.on("init", (user: any) => {
          if (!user) {
            // @ts-ignore
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </body>
</html>
