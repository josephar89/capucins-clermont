---
---

<section class="bg-white rounded-3xl overflow-hidden border border-stone-200/90 shadow-sm">
  <div class="grid grid-cols-1 lg:grid-cols-12">
    
    <!-- Info Column -->
    <div class="lg:col-span-5 p-6 sm:p-8 lg:p-10 flex flex-col justify-between space-y-6">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-[#7B462C] uppercase tracking-wider mb-3">
          Venir à la Chapelle
        </span>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-[#3A2216]">
          Nous Trouver à Clermont-Ferrand
        </h2>
        <p class="text-stone-600 text-sm mt-3 leading-relaxed">
          La chapelle et le couvent des Frères Capucins sont situés en plein cœur de Clermont-Ferrand, à l'intersection du Boulevard Lafayette et du Cours Sablon, en face de l'entrée du Jardin Lecoq.
        </p>
      </div>

      <div class="space-y-4">
        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-[#FAF7F2] border border-stone-200">
          <div class="w-8 h-8 rounded-lg bg-amber-200/60 text-[#7B462C] flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <div class="text-xs sm:text-sm">
            <p class="font-bold text-stone-900">Adresse postale :</p>
            <p class="text-stone-600">9 Boulevard Lafayette, 63000 Clermont-Ferrand</p>
            <p class="text-[11px] text-amber-800 font-medium mt-0.5">En face du Jardin Lecoq / Proche Facultés</p>
          </div>
        </div>

        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-[#FAF7F2] border border-stone-200">
          <div class="w-8 h-8 rounded-lg bg-amber-200/60 text-[#7B462C] flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          </div>
          <div class="text-xs sm:text-sm">
            <p class="font-bold text-stone-900">Accès Transports en commun (T2C) :</p>
            <p class="text-stone-600">Tram A : Arrêt <em>Universités</em> ou <em>Ballainvilliers</em></p>
            <p class="text-stone-600">Bus : Lignes 3, 4, 8, 12, 13 (Arrêt <em>Jardin Lecoq</em> ou <em>Carnot</em>)</p>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <a
          href="https://maps.google.com/?q=9+Boulevard+Lafayette+63000+Clermont-Ferrand"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#7B462C] text-white font-semibold text-sm hover:bg-[#5E3420] shadow-sm transition active:scale-95 text-center"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Ouvrir dans Google Maps
        </a>
        <a
          href="tel:0473926638"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-stone-300 text-stone-700 font-semibold text-sm hover:bg-stone-50 transition"
        >
          📞 Nous Appeler
        </a>
      </div>
    </div>

    <!-- Map Column -->
    <div class="lg:col-span-7 h-80 lg:h-auto min-h-[350px] relative bg-stone-100">
      <iframe
        title="Carte d'accès Frères Capucins Clermont-Ferrand"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2782.359288151219!2d3.0886567768565013!3d45.77395021272656!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47f71b953c829e09%3A0xe54c405a46df8cf0!2s9%20Bd%20Lafayette%2C%2063000%20Clermont-Ferrand!5e0!3m2!1sfr!2sfr!4v1710000000000!5m2!1sfr!2sfr"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="w-full h-full min-h-[350px]"
      ></iframe>
    </div>

  </div>
</section>
