---
interface Props {
  id: string;
  title: string;
  date: string;
  time?: string;
  location?: string;
  summary: string;
  image?: string;
  featured?: boolean;
}

const { id, title, date, time, location, summary, image, featured = false } = Astro.props;

// Format date into French
const eventDate = new Date(date);
const day = eventDate.getDate();
const month = eventDate.toLocaleDateString('fr-FR', { month: 'short' }).toUpperCase();
const fullDateStr = eventDate.toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageUrl = image ? (image.startsWith('http') || image.startsWith(base) ? image : `${base}${image}`) : undefined;
---

<article class={`group bg-white rounded-2xl overflow-hidden border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 flex flex-col ${featured ? 'border-amber-400 ring-1 ring-amber-300/50' : 'border-stone-200 shadow-sm'}`}>
  <!-- Card Image with Date Badge -->
  <div class="relative h-48 sm:h-52 w-full overflow-hidden bg-stone-100">
    {image ? (
      <img
        src={imageUrl}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-[#7B462C] to-[#452718] flex items-center justify-center">
        <span class="text-amber-200/50 font-display text-4xl font-bold">CAPUCINS</span>
      </div>
    )}

    <!-- Date Badge -->
    <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md rounded-xl px-3 py-1.5 shadow-md text-center border border-stone-200/60">
      <span class="block text-lg font-bold text-[#7B462C] leading-none font-display">{day}</span>
      <span class="block text-[10px] font-bold tracking-wider text-stone-600 uppercase leading-tight mt-0.5">{month}</span>
    </div>

    {featured && (
      <div class="absolute top-3 right-3 bg-amber-500 text-stone-900 text-[11px] font-bold px-2.5 py-1 rounded-full shadow-md uppercase tracking-wider">
        À la une
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="p-5 sm:p-6 flex flex-col flex-grow">
    <!-- Meta details (time & location) -->
    <div class="flex flex-wrap items-center gap-y-1 gap-x-3 text-xs text-stone-500 mb-2.5">
      {time && (
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {time}
        </span>
      )}
      {location && (
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
          {location}
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="font-display font-bold text-lg sm:text-xl text-[#3A2216] group-hover:text-[#7B462C] transition-colors leading-snug line-clamp-2 mb-2">
      <a href={`${base}/evenements/${id}`}>
        {title}
      </a>
    </h3>

    <!-- Summary -->
    <p class="text-stone-600 text-sm line-clamp-3 leading-relaxed mb-4 flex-grow">
      {summary}
    </p>

    <!-- Read more footer -->
    <div class="pt-3 border-t border-stone-100 flex items-center justify-between mt-auto">
      <span class="text-xs text-stone-400 capitalize">{fullDateStr}</span>
      <a href={`${base}/evenements/${id}`} class="inline-flex items-center gap-1 text-xs font-semibold text-[#7B462C] group-hover:underline">
        En savoir plus
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</article>
